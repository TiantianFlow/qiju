    "@qiju/contracts": "workspace:*",
    "@qiju/game-core": "workspace:*",
    "@qiju/replay": "workspace:*",
    "@qiju/rules-demo": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
