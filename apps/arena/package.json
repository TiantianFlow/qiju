{
  "name": "@qiju/arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "qiju-arena": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
