# Frontend environment variables (apps/web), read at build time by Vite.
# Copy to .env.local for local overrides (gitignored) or set in your hosting
# platform's build settings (e.g. Cloudflare Pages).

# Backend API base URL. Leave empty/unset for local dev (uses the Vite dev
# proxy) and same-origin deploys. Set to the backend's origin when the
# frontend and backend are deployed separately (e.g. Cloudflare Pages +
# Railway) — no trailing slash.
# Example: VITE_API_URL=https://api.example.com
VITE_API_URL=
