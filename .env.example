# Server environment variables (apps/server). These are read directly from
# process.env — there's no .env loader wired in, so export them in your shell
# or set them in your hosting platform's dashboard (e.g. Railway).
#
# Copy to .env for reference and set the real values elsewhere; this repo
# does not read a .env file at runtime.

# Network
PORT=3000
HOST=0.0.0.0

# Required in production (NODE_ENV=production): a random secret used to sign
# the guest-session cookie. Generate one with: openssl rand -hex 32
COOKIE_SECRET=

# Environment mode. In production this enables SameSite=None + Secure guest
# cookies (required for a cross-origin frontend) and requires COOKIE_SECRET.
NODE_ENV=development

# Comma-separated list of allowed frontend origins for cross-origin deploys
# (e.g. a Cloudflare Pages domain). Leave unset for local dev / same-origin
# deploys, where any origin is allowed.
# Example: CORS_ORIGIN=https://demo.example.com
CORS_ORIGIN=

# Cookie domain shared between frontend/backend subdomains of the same parent
# domain, so the guest-session cookie is visible to both. Leave unset for a
# host-only cookie (fine for same-origin or single-domain deploys).
# Example: COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# Misc
LOG_LEVEL=info
ALLOW_FIXED_SEED=true

# THE-37a: Supabase identity (anonymous auth). Guest identity is a real
# auth.users row; the browser holds a server-minted session in the signed
# httpOnly lv_session cookie. For local development get these from
# `supabase start` / `supabase status -o env` (local project "qiju").
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Used exclusively for signInAnonymously (with a request-local
# Sb-Forwarded-For header). Must never reach the browser, a client bundle, a
# log line, a test fixture, or a committed file with a real value.
SUPABASE_SECRET_KEY=

# Client-IP trust boundary (default: untrusted — the socket peer is used and
# caller-supplied forwarding headers are ignored). When "true", the
# CF-Connecting-IP header is trusted as the client IP, which changes both
# Sb-Forwarded-For forwarding and rate-limit bucketing. Enabling this safely
# in production requires Cloudflare-proxied backend ingress AND direct origin
# ingress blocked or validated — an unresolved infra decision; leave false
# until that is settled.
TRUST_CF_CONNECTING_IP=false
