# Server environment variables (apps/server). These are read directly from
# process.env — there's no .env loader wired in, so export them in your shell
# or set them in your hosting platform's dashboard (e.g. Railway).
#
# Copy to .env for reference and set the real values elsewhere; this repo
# does not read a .env file at runtime.

# Network
PORT=3000
HOST=0.0.0.0

# Required in production (NODE_ENV=production): a random secret used to sign
# the guest-session cookie. Generate one with: openssl rand -hex 32
COOKIE_SECRET=

# Environment mode. In production this enables SameSite=None + Secure guest
# cookies (required for a cross-origin frontend) and requires COOKIE_SECRET.
NODE_ENV=development

# Comma-separated list of allowed frontend origins for cross-origin deploys
# (e.g. a Cloudflare Pages domain). Leave unset for local dev / same-origin
# deploys, where any origin is allowed.
# Example: CORS_ORIGIN=https://demo.example.com
CORS_ORIGIN=

# Cookie domain shared between frontend/backend subdomains of the same parent
# domain, so the guest-session cookie is visible to both. Leave unset for a
# host-only cookie (fine for same-origin or single-domain deploys).
# Example: COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# Misc
DATA_DIR=data
LOG_LEVEL=info
ALLOW_FIXED_SEED=true
